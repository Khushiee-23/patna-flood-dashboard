const express = require('express');
const cors = require('cors');
const app = express();
app.use(cors());
app.use(express.json());

const cron = require('node-cron');
let sensors = {}; // Global for realtime sim

// Simulation cron: Updates every 5 mins (IoT-like polling)
cron.schedule('*/5 * * * *', () => {
    const now = Date.now() / 1000; // Unix for realism
    const rain = 0.2 + Math.random() * 8 + (Math.sin(now / 3600) * 2); // Hourly variance
    const waterBase = 48.2 + Math.sin(now / 86400) * 1.8; // Daily tide (Ganga Patna)
    const waterGlobal = Math.min(55, waterBase + rain * 0.4 + Math.random() * 0.5); // Flood cap

    const status = waterGlobal > 52 ? 'FLOOD' : waterGlobal > 50 ? 'WARNING' : 'SAFE';

    // Panchayats from case study (lat/lng approx Patna area)
    const panchayats = [
        { name: 'Maner', water: (waterGlobal + 0.3 + Math.random() * 0.4).toFixed(2), lat: 25.65, lng: 85.00, status },
        { name: 'Bihta', water: (waterGlobal - 0.2 + Math.random() * 0.3).toFixed(2), lat: 25.50, lng: 84.90, status },
        { name: 'Daniawan', water: (waterGlobal + 0.1 + Math.random() * 0.5).toFixed(2), lat: 25.55, lng: 85.20, status },
        { name: 'Masaurhi', water: (waterGlobal - 0.5 + Math.random() * 0.4).toFixed(2), lat: 25.38, lng: 85.12, status },
        { name: 'Phulwari Sharif', water: (waterGlobal + 0.4 + Math.random() * 0.3).toFixed(2), lat: 25.58, lng: 85.15, status }
    ];

    sensors = {
        timestamp: new Date().toISOString(),
        location: 'Patna District, Bihar (Ganga Basin)',
        global: {
            water_level_m: waterGlobal.toFixed(2),
            rainfall_mm_hr: rain.toFixed(1),
            status,
            danger_mark: '52.0m (Ghat avg)'
        },
        panchayats,
        rs_images: ['sentinel_cloud.jpg', 'flood_extent.jpg'], // Mock RS (add dummy imgs to data/)
        raw_data: { rain_samples: [rain - 0.5, rain, rain + 0.5] } // For ML later
    };

    // Push to Firebase (if initialized)
    // db.ref('sensors/latest').set(sensors);
    console.log('Updated sensors:', sensors.global); // Terminal log
});

